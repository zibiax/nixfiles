{
  "layer": "top",
  // "layer": "top", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  "height": 36, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  // "spacing": 4, // Gaps between modules (4px)
  "output": "DP-1",
  // Choose the order of the modules
  // custom/ws* replace "hyprland/workspaces": its click is broken with hyprland.lua
  "modules-left": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
                   "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "clock", "custom/kernel", "custom/pacman","mpd"],
  "modules-center": ["hyprland/window"],
  "modules-right": [ "tray", "temperature", "cpu", "memory","network", "pulseaudio"],

  // Modules configuration

  "clock": {
    "format": "<span color=\"#7aa2f7\"> </span>{:%H:%M:%S}",
    "format-alt": "<span color=\"#7aa2f7\"> </span>{:%d-%m-%Y}",
    "interval": 1
  },
  "cpu": {
    "format": "<span color=\"#7aa2f7\"> </span>{}%",
    "tooltip": false,
    "interval": 3
  },
  
  "memory": {
    "format": "<span color=\"#7aa2f7\"> </span>{used}GiB",
    "interval": 3
  },

  "temperature": {
    // "thermal-zone": 2,
    // hwmonN numbering changes between boots; this is the CPU's k10temp (Tctl).
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    // "hwmon-path": "/tmp/nvidia-temp",
    // "critical-threshold": 80,
    "format": "<span color=\"#7aa2f7\"> </span>{temperatureC}°C",
    "interval": 3
  },

  "pulseaudio": {
    "scroll-step": 5, // %, can be a float
    "format": "<span color=\"#7aa2f7\">{icon} </span>{volume}%",
    "format-muted": "<span color=\"#f7768e\"> </span>Muted",
    "format-icons": ["", "", ""],
    "on-click": "pavucontrol"
  },

  "hyprland/window": {
    "max-length": 48,
    "format": "{}"
  },

  "custom/kernel": {
    "exec": "uname -r | cut -d '-' -f1",
    "interval": "once",
    "format": "<span color=\"#7aa2f7\"> </span>{}"
  },

  "custom/pacman": {
    "exec": "$XDG_CONFIG_HOME/waybar/scripts/package-updates.sh",
    "format": "<span color=\"#7aa2f7\"> </span>{}",
    "interval": 600,
    "signal": 1
  },
  
  "custom/pacman": {
    "exec": "$HOME/.config/waybar/scripts/package-updates.sh",
    "format": "<span color=\"#7aa2f7\"> </span>{}",
    "interval": 600,
    "signal": 1
  },

  "custom/sep": {
    "format": "|",
    "interval": "once"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
  },
  "custom/ws1": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 1",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws2": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 2",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws3": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 3",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws4": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 4",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws5": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 5",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws6": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 6",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws7": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 7",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws8": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 8",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "custom/ws9": {
    "exec": "$HOME/.config/waybar/scripts/ws-button.sh 9",
    "return-type": "json",
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "tooltip": false
  },
  "mpd": {
    "format": "<span color=\"#7aa2f7\">{stateIcon} </span>{artist} - {title}",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "format-paused": "",
    "interval": 10,
    "consume-icons": {
      "on": " " // Icon shows only when "consume" is on
    },
    "random-icons": {
      "off": "<span color=\"#f53c3c\"></span> ", // Icon grayed out when "random" is off
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)"
  },
  "network": {
    "icon-size": 8,
    "interval": 10,
    "spacing": 8,
	"interface": "enp39s0",
	"format": "{ifname}",
    "format-wifi": "{essid} ({signalStrength}%) ",
	"format-ethernet": "{ifname} ",
	"format-disconnected": "", //An empty format will hide the module.
	"format-disconnected": "",
	"tooltip-format": "{ifname}",
	"tooltip-format-wifi": "{essid} ({signalStrength}%) ",
	"tooltip-format-ethernet": "{ifname} ",
	"tooltip-format-disconnected": "Disconnected",
	"max-length": 50
  }
}
